{
	"name": "superforms-examples-base",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"rebase": "git branch --format=%(refname:short) | xargs -n 1 -t git rebase main && git checkout main",
		"push": "git push --all origin",
		"corefix": "set COREPACK_ENABLE_AUTO_PIN=0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/eslint": "^9.6.1",
		"@typescript-eslint/eslint-plugin": "^8.53.0",
		"@typescript-eslint/parser": "^8.53.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"normalize.css": "^8.0.1",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"sakura.css": "^1.5.1",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"sveltekit-superforms": "^2.29.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.17"
	},
	"type": "module",
	"dependencies": {
		"valibot": "^1.2.0"
	}
}
